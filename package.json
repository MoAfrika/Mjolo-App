{
  "name": "mjolo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:integration": "node --test --test-concurrency=1 test/integration.mjs",
    "test:ui": "node test/browser.mjs",
    "admin:provision": "node scripts/provision-admin.mjs",
    "db:start": "node scripts/start-local.mjs",
    "db:reset": "var/bin/supabase db reset",
    "db:install": "node scripts/install-supabase.mjs",
    "staging:access": "python3 scripts/staging-access.py",
    "staging:build": "node scripts/staging-build.mjs",
    "staging:check-tools": "python3 -m unittest discover -s test -p 'staging_tools_test.py'"
  },
  "dependencies": {
    "@netlify/functions": "^5.1.0",
    "@supabase/supabase-js": "^2.95.0",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.468.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
